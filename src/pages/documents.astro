---
import Layout from "../layouts/Layout.astro";
import { Header } from "../components/base/Header";
import { Footer } from "../components/base/Footer";
import { Content } from "../components/base/Content";
import { Documents as DocumentsContent } from "../components/content/documents/Documents";
import { BackToTop } from "../components/ui/back-to-top/BackToTop";
---

<Layout>
  <Header pageType="documents" client:load />
  <Content>
    <DocumentsContent client:load />
  </Content>
  <Footer client:load/>
  <BackToTop client:load/>
</Layout>