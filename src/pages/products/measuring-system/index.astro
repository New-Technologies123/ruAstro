---
import Layout from "../../../layouts/Layout.astro";
import { Header } from "../../../components/base/Header";
import { Footer } from "../../../components/base/Footer";
import { Content } from "../../../components/base/Content";
import { MeasuringSystem } from "../../../components/content/products/MeasuringSystem";

const description = "Подробная информация о системе учёта углеводородов и пластовой жидкости, системе измерения количества и показателей качества нефти (СИКН), Система измерения количества газа (СИКГ), Система измерения количества воды (СИКВ)";
---

<Layout description={description}>
  <Header pageType="products" client:load />
    <Content>
      <MeasuringSystem client:load />
    </Content>
  <Footer client:load/>
</Layout>