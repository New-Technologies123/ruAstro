---
import Layout from "../../../layouts/Layout.astro";
import { Header } from "../../../components/base/Header";
import { Footer } from "../../../components/base/Footer";
import { Content } from "../../../components/base/Content";
import { Accessories_6 } from "../../../components/content/products/Accessories/Accessories_6";

const description = "Сепарационная ёмкость";
---

<Layout description={description}>
  <Header pageType="products" client:load />
    <Content>
      <Accessories_6
        title="Сепарационная ёмкость"
        onBackAccessories={() => history.back()}
      />
    </Content>
  <Footer client:load/>
</Layout>