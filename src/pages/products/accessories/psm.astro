---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/base/Header';
import { Footer } from '../../../components/base/Footer';
import { Content } from '../../../components/base/Content';
import { Psm as PsmContent} from '../../../components/content/products/Accessories/Psm';

const description = 'Переключатель скважин многоходовой (ПСМ), псм, переключатель скважин, псм агзу, псм для агзу, псм гидравлика';
---

<Layout description={description}>
  <Header pageType="products" client:load />
  <Content>
    <PsmContent client:load />
  </Content>
  <Footer client:load />
</Layout>
