---
import Layout from "../../layouts/Layout.astro";
import { Header } from "../../components/base/Header";
import { Footer } from "../../components/base/Footer";
import { Content } from "../../components/base/Content";
import { PumpingStations as PumpingContent} from "../../components/content/products/PumpingStations";

const description = "Насосные станции перекачки нефти, нефтепродуктов и воды; блочная насосная станция внутренней и внешней перекачки нефти; блочная мультифазная насосная станция; насосные станции; насосные станции перекачки нефти";
---

<Layout description={description}>
  <Header pageType="products" client:load />
    <Content>
      <PumpingContent client:load />
    </Content>
  <Footer client:load/>
</Layout>