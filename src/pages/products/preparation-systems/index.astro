---
import Layout from "../../../layouts/Layout.astro";
import { Header } from "../../../components/base/Header";
import { Footer } from "../../../components/base/Footer";
import { Content } from "../../../components/base/Content";
import { PreparationSystems } from "../../../components/content/products/PreparationSystems";

const description = "Подробная информация о системе подготовки нефти, газа и воды; устройстве запуска и приема внутритрубных средств очистки и диагностики УЗПЗ, УЗПП; блок гребенки (БГ); устройство очистки колонны УОК-НКТ; установка дозирования химического реагента (БДР)";
---

<Layout description={description}>
  <Header pageType="products" client:load />
    <Content>
      <PreparationSystems client:load />
    </Content>
  <Footer client:load/>
</Layout>