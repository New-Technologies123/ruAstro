import { Footer } from "../../../components/base/Footer";
import { Content } from "../../../components/base/Content";
import { Launch as LaunchContent} from "../../../components/content/products/PreparationSystems/Launch";

const description = "Устройство запуска и приема внутритрубных средств очистки и диагностики УЗПЗ, УЗПП, устройство запуска и приема внутритрубных средств очистки, прием внутритрубных средств очистки";
