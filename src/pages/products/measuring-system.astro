---
import Layout from '../../layouts/Layout.astro';
import { Header } from '../../components/base/Header';
import { Footer } from '../../components/base/Footer';
import { Content } from '../../components/base/Content';
import { MeasuringSystem as MeasuringContent } from '../../components/content/products/MeasuringSystem';

const description = 'Система учёта углеводородов и пластовой жидкости';
---

<Layout description={description}>
  <Header pageType="products" client:load />
  <Content>
    <MeasuringContent client:load />
  </Content>
  <Footer client:load />
</Layout>
