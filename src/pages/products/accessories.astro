---
import Layout from '../../layouts/Layout.astro';
import { Header } from '../../components/base/Header';
import { Footer } from '../../components/base/Footer';
import { Content } from '../../components/base/Content';
import { Accessories as AccessoriesContent } from '../../components/content/products/Accessories';

const description = 'Комплектующие для автоматизированной групповой замерной установки, комплектующие для АГЗУ, комплектующие агзу';
---

<Layout description={description}>
  <Header pageType="products" client:load />
  <Content>
    <AccessoriesContent client:load />
  </Content>
  <Footer client:load />
</Layout>
