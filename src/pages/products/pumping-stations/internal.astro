---
import Layout from "../../../layouts/Layout.astro";
import { Header } from "../../../components/base/Header";
import { Footer } from "../../../components/base/Footer";
import { Content } from "../../../components/base/Content";
import { Internal as InternalContent} from "../../../components/content/products/PumpingStations/Internal";

const description = "Блочная насосная станция внутренней и внешней перекачки нефти, блочная станция переачки нефти, станция насосная нефтяная, станция внутренней и внешней перекачки нефти, блочная насосная станция, станция перекачки нефти, насосная станция, внутренняя перекачка нефти, внешняя перекачка нефти";
---

<Layout description={description}>
  <Header pageType="products" client:load />
    <Content>
      <InternalContent  client:load/>
    </Content>
  <Footer client:load/>
</Layout>