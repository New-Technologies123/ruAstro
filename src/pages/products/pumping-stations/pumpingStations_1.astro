---
import Layout from "../../../layouts/Layout.astro";
import { Header } from "../../../components/base/Header";
import { Footer } from "../../../components/base/Footer";
import { Content } from "../../../components/base/Content";
import { PumpingStations_1 } from "../../../components/content/products/PumpingStations/PumpingStations_1";

const description = "Блочная насосная станция внутренней и внешней перекачки нефти";
---

<Layout description={description}>
  <Header pageType="products" client:load />
    <Content>
      <PumpingStations_1
        title="Насосные станции перекачки нефти, нефтепродуктов и воды"
        onBackPumping={() => history.back()}
      />
    </Content>
  <Footer client:load/>
</Layout>