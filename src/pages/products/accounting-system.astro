---
import Layout from "../../layouts/Layout.astro";
import { Header } from "../../components/base/Header";
import { Footer } from "../../components/base/Footer";
import { Content } from "../../components/base/Content";
import { AccountingSystem as AccountingContent } from "../../components/content/products/AccountingSystem";

const description = "Автоматизированная замерная установка (АГЗУ), агзу, установка автоматизированная измерительная, измерительная установка, замерная установка, ИС установка для замера дебата, МЕРА, «спутник-массомер» нт.1";
---

<Layout description={description}>
  <Header pageType="products" client:load />
    <Content>
      <AccountingContent client:load />
    </Content>
  <Footer client:load/>
</Layout>