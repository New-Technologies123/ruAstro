---
import Layout from "../../layouts/Layout.astro";
import { Header } from "../../components/base/Header";
import { Footer } from "../../components/base/Footer";
import { Content } from "../../components/base/Content";
import { Metering as MeteringContent } from "../../components/content/services/Metering";

const description = "Сервисные услуги, замер дебита нефтяных скважин с помощью мобильной замерной установки, замер дебита включает в себя";
---

<Layout description={description}>
  <Header pageType="services" client:load />
    <Content>
      <MeteringContent client:load />
    </Content>
  <Footer client:load/>
</Layout>