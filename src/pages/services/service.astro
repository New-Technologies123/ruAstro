---
import Layout from "../../layouts/Layout.astro";
import { Header } from "../../components/base/Header";
import { Footer } from "../../components/base/Footer";
import { Content } from "../../components/base/Content";
import { Service as ServiceContent } from "../../components/content/services/Service";

const description = "Сервисные услуги, обслуживание устройства очистки колонны УОК-НКТ, обслуживание устройства уок-нкт, очистка колонны, очистка колонны уок-нкт, техническое обслуживание смонтированного устройства, техническое обслуживание учтройства";
---

<Layout description={description}>
  <Header pageType="services" client:load />
    <Content>
      <ServiceContent client:load />
    </Content>
  <Footer client:load/>
</Layout>