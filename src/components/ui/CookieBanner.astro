<div
  id="cookie-banner"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-description"
  aria-hidden="true"
>
  <div class="cookie-content">
    <div class="cookie-text">
      <div class="cookie-message">
        <strong id="cookie-title"> Cookies на сайте </strong>

        <p id="cookie-description">
          Используем cookies для работы сайта, аналитики и персонализации. <a href="/file/cookie_v1.pdf" target="_blank" rel="noopener noreferrer" class="cookie-link"> Политика cookies </a>.
        </p>
      </div>
    </div>

    <div class="cookie-actions">
      <button type="button" id="cookie-accept" aria-label="Принять использование cookies"> Принять </button>
    </div>
  </div>
</div>

<style lang="scss">
  @use '../../styles/buttons' as buttons;

  :global(body[data-cart-open='true']) #cookie-banner {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: none;
  }

  #cookie-banner {
    position: fixed;
    z-index: 99999;
    left: 50%;
    bottom: 16px;
    width: min(560px, calc(100% - 32px));
    padding: 14px 16px;
    border: 1px solid rgba(255, 255, 255, .18);
    border-radius: 14px;
    background: var(--site-navy);
    color: #fff;
    box-shadow: 0 8px 28px rgba(3, 15, 31, .2);
    transform: translate(-50%, calc(100% + 32px));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 220ms ease, opacity 180ms ease, visibility 180ms ease;
  }

  #cookie-banner.show {
    transform: translate(-50%, 0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .cookie-content { display: flex; align-items: center; gap: 14px; }
  .cookie-text { flex: 1; min-width: 0; }
  .cookie-message strong {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .cookie-message p { margin: 0; color: #d5e2ef; font-size: 13px; line-height: 1.5; }
  .cookie-link { color: #b8d8ff; text-decoration: underline; text-underline-offset: 3px; }
  .cookie-link:hover { color: #fff; }
  .cookie-link:focus-visible { outline: 3px solid var(--site-blue-light); outline-offset: 3px; }
  .cookie-actions { flex: 0 0 auto; }
  #cookie-accept { min-width: 92px; @include buttons.primary($compact: true); }

  @media (max-width: 600px) {
    #cookie-banner { bottom: 10px; width: calc(100% - 24px); padding: 12px; border-radius: 12px; }
    .cookie-content { gap: 12px; }
    #cookie-accept { min-width: 82px; padding-inline: 12px; }
  }

  @media (prefers-reduced-motion: reduce) { #cookie-banner { transition: none; } }
</style>

<script>
  (function () {
    'use strict';

    /* =======================================================
     CONFIG
     ======================================================= */

    const COOKIE_KEY = 'cookie_consent';

    /* =======================================================
     ELEMENTS
     ======================================================= */

    const bannerElement = document.getElementById('cookie-banner');

    const acceptButtonElement = document.getElementById('cookie-accept');

    /* =======================================================
     TYPE CHECK
     ======================================================= */

    if (!(bannerElement instanceof HTMLElement)) {
      return;
    }

    if (!(acceptButtonElement instanceof HTMLButtonElement)) {
      return;
    }

    /*
     * После этих проверок TypeScript знает,
     * что элементы существуют.
     */

    const banner: HTMLElement = bannerElement;

    const acceptButton: HTMLButtonElement = acceptButtonElement;

    /* =======================================================
     STORAGE
     ======================================================= */

    function hasAcceptedCookies(): boolean {
      try {
        return localStorage.getItem(COOKIE_KEY) === 'accepted';
      } catch {
        return false;
      }
    }

    function saveConsent(): void {
      try {
        localStorage.setItem(COOKIE_KEY, 'accepted');
      } catch {
        /*
         * Если localStorage недоступен,
         * ничего критичного не происходит.
         */
      }
    }

    /* =======================================================
     SHOW
     ======================================================= */

    function showBanner(): void {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          banner.classList.add('show');

          banner.setAttribute('aria-hidden', 'false');
        });
      });
    }

    /* =======================================================
     HIDE
     ======================================================= */

    function hideBanner(): void {
      banner.classList.remove('show');

      window.setTimeout(() => {
        if (!banner.classList.contains('show')) {
          banner.setAttribute('aria-hidden', 'true');
        }
      }, 500);
    }

    /* =======================================================
     ACCEPT
     ======================================================= */

    function acceptCookies(): void {
      /*
       * Сохраняем согласие.
       */

      saveConsent();

      /*
       * Скрываем баннер.
       */

      hideBanner();

      /*
       * Отправляем глобальное событие.
       *
       * Его можно использовать для запуска:
       *
       * Yandex.Metrika
       * Google Analytics
       * Google Tag Manager
       */

      window.dispatchEvent(
        new CustomEvent('cookieConsentAccepted', {
          detail: {
            consent: true,
          },
        }),
      );
    }

    /* =======================================================
     BUTTON
     ======================================================= */

    acceptButton.addEventListener('click', acceptCookies);

    /* =======================================================
     INIT
     ======================================================= */

    function initCookieBanner(): void {
      /*
       * Пользователь уже соглашался.
       */

      if (hasAcceptedCookies()) {
        banner.classList.remove('show');

        banner.setAttribute('aria-hidden', 'true');

        return;
      }

      /*
       * Согласия ещё нет.
       */

      banner.setAttribute('aria-hidden', 'true');

      /*
       * Небольшая задержка после загрузки страницы.
       */

      window.setTimeout(() => {
        showBanner();
      }, 450);
    }

    /* =======================================================
     DOM READY
     ======================================================= */

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCookieBanner, {
        once: true,
      });
    } else {
      initCookieBanner();
    }
  })();
</script>
